# ==========================================
# AirTrace MP — Environment Configuration
# ==========================================

# Database (PostgreSQL - Neon / Supabase / Local)
DATABASE_URL="postgres://user:password@localhost:5432/airtrace"
DEMO_MODE=true
NEXT_PUBLIC_DEMO_MODE=true

# Next.js Application Frontend
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Clerk Authentication (Frontend & Backend)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
CLERK_WEBHOOK_SECRET=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/console"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/citizen"
CLERK_JWKS_URL=""
CLERK_ISSUER=""
CLERK_AUTHORIZED_PARTIES=""

# OpenAQ v3
OPENAQ_API_KEY=""

# NASA FIRMS (Satellite Thermal Fire Feed)
FIRMS_MAP_KEY=""

# data.gov.in (CPCB fallback)
DATA_GOV_IN_KEY=""

# Anthropic Claude API (Optional for /explain endpoint)
ANTHROPIC_API_KEY=""

# Telegram Alerts Dispatcher (Optional)
TELEGRAM_BOT_TOKEN=""

# CORS & Server Config
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
TIMEZONE="Asia/Kolkata"
